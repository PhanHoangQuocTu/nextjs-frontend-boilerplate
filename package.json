{
  "name": "frontend-boilerplate",
  "version": "0.1.0",
  "description": "Production-ready Next.js frontend boilerplate",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-framework.mjs next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint . --write",
    "format:check": "biome format .",
    "format:fix": "biome format . --write",
    "type-check": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test",
    "postinstall": "husky",
    "storybook": "node scripts/run-framework.mjs storybook dev -p 6006",
    "build-storybook": "node scripts/run-framework.mjs storybook build",
    "verify": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bprogress/next": "^3.2.12",
    "@hookform/resolvers": "^7.0.9",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "auto-zustand-selectors-hook": "^3.0.1",
    "axios": "^1.21.1",
    "bignumber.js": "^11.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "14.14.0",
    "input-otp": "^1.5.0",
    "js-cookie": "^3.0.8",
    "lucide-react": "1.79.0",
    "next": "^16.4.6",
    "next-intl": "4.16.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "4.24.1",
    "recharts": "^3.11.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-themes": "10.6.8",
    "@storybook/nextjs-vite": "10.6.8",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "storybook": "10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{css,js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc}": [
      "biome lint --write --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
