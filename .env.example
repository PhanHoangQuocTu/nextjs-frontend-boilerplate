# Do not include a trailing slash in URLs.
# Copy to `.env.local` for development.

NEXT_PUBLIC_APP_ENV=development # production | staging | development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend origin for calls through the Next.js BFF (/api/*).
# JSONPlaceholder is only for the posts demo. Replace it when connecting your
# own backend, or remove this setting and its default if the app has no backend.
NEXT_PUBLIC_API_URL="https://jsonplaceholder.typicode.com"
